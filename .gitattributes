# The project's own convention (tools/normalize-eol.mjs): CRLF for markup,
# styles and scripts; LF for JSON and for anything a Linux runner executes.
*.html   text eol=crlf
*.css    text eol=crlf
*.js     text eol=crlf
*.mjs    text eol=crlf
*.md     text eol=crlf
*.json   text eol=lf
*.yml    text eol=lf
*.py     text eol=lf
*.sql    text eol=lf
*.ts     text eol=lf
*.svg    text eol=lf
*.xml    text eol=crlf
*.txt    text eol=crlf
*.mp4    binary
*.webp   binary
*.png    binary
*.jpg    binary
